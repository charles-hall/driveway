# Copy to .env on the server and fill in. Never commit .env.

# Public address of the app (no trailing slash)
BASE_URL=https://driveway.oaksync.com

# SQLite file, kept outside public_html so it can never be downloaded
DB_PATH=/home/tallazpo/driveway-data/tallazpo_driveway.sqlite

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: https://driveway.oaksync.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The first owner. This Google account is created as Owner on first start.
OWNER_EMAIL=

# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Web Push keys: run `npm run vapid` once and paste the output here
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Time zone used for reminder dates
TZ=America/New_York
